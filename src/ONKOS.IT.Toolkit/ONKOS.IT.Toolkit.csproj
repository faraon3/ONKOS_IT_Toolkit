<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ONKOS_IT_Toolkit</AssemblyName>
    <RootNamespace>ONKOS.IT.Toolkit</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.4</Version>
    <FileVersion>1.1.4.0</FileVersion>
    <AssemblyVersion>1.1.4.0</AssemblyVersion>
    <Company>Clínica Onkos</Company>
    <Product>ONKOS IT Toolkit</Product>
    <Description>Herramienta portable de soporte técnico</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\**\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
